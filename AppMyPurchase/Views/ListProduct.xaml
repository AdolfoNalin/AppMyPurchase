<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMyPurchase.Views.ListProduct"
             Title="{Binding Descrição}">

    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Somar"
            Clicked="ToolbarItem_Clicked_1"/>
        <ToolbarItem
            Text="Adicionar"
            Clicked="ToolbarItem_Clicked"/>
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="VerticalTextAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <StackLayout>
        <SearchBar 
            Margin="15"
            x:Name="txtSeach"
            Placeholder="Pesquisa"
            TextChanged="txtSeach_TextChanged"/>
        <Border
            Margin="10"
            Padding="0"
            HorizontalOptions="Center"
            Stroke="Transparent">
            
            <ListView
            x:Name="lstProduct"
            IsPullToRefreshEnabled="True"
            Refreshing="lstProduct_Refreshing"  
            ItemSelected="lstProduct_ItemSelected">
                <ListView.Header>
                    <Grid
                        BackgroundColor="Grey"
                        Padding="20"
                        Margin="10"
                        ColumnDefinitions="*,*,*,*,*">
                        <Label 
                            Grid.Column="0"
                            Text="Id"
                            FontAttributes="Bold"/>

                        <Label 
                            Grid.Column="1"
                            Text="Descrição"
                            FontAttributes="Bold"/>

                        <Label 
                            Grid.Column="2"
                            Text="Qtd"
                            FontAttributes="Bold"/>

                        <Label 
                            Grid.Column="3"
                            Text="Preço"
                            FontAttributes="Bold"/>

                        <Label 
                            Grid.Column="4"
                            Text="Total"
                            FontAttributes="Bold"/>
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ViewCell.ContextActions>
                                <MenuItem 
                                Text="Remover"
                                Clicked="MenuItem_Clicked_Delete"
                                CommandParameter="{Binding .}"/>

                            </ViewCell.ContextActions>
                            <Grid
                                Margin="10"
                                Padding="10"
                                ColumnDefinitions="*,*,*,*,*">
                                <Label 
                                Grid.Column="0"
                                Text="{Binding Id}"/>

                                <Label 
                                 Grid.Column="1"
                                 Text="{Binding Description}"/>

                                <Label 
                                 Grid.Column="2"
                                 Text="{Binding Amount}"/>

                                <Label 
                                 Grid.Column="3"
                                 Text="{Binding Price, StringFormat='{}{0:c}'}"/>

                                <Label 
                              Grid.Column="4"
                              Text="{Binding Total, StringFormat='{}{0:c}'}"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </StackLayout>
</ContentPage>