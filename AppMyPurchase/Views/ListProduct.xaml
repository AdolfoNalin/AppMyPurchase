<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMyPurchase.Views.ListProduct"
             Title="{Binding Descrição}">

    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Somar"
            Clicked="ToolbarItem_Clicked_1"/>
        <ToolbarItem
            Text="Adicionar"
            Clicked="ToolbarItem_Clicked"/>
    </ContentPage.ToolbarItems>

    <VerticalStackLayout>
        <SearchBar 
            x:Name="txtSeach"
            Placeholder="Pesquisa"
            TextChanged="txtSeach_TextChanged"/>
        <ListView
            x:Name="lstProduct"
            ItemSelected="lstProduct_ItemSelected">
            <ListView.Header>
                <Grid
                    ColumnDefinitions="*,*,*,*,*">
                    <Label 
                        Grid.Column="0"
                        Text="Id"/>

                    <Label 
                         Grid.Column="1"
                         Text="Descrição"/>

                    <Label 
                         Grid.Column="2"
                         Text="Qtd"/>

                    <Label 
                         Grid.Column="3"
                         Text="Preço"/>

                    <Label Grid.Column="4"
                           Text="Total"/>
                </Grid>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <ViewCell.ContextActions>
                            <MenuItem 
                                Text="Remover"
                                Clicked="MenuItem_Clicked_Delete"
                                CommandParameter="{Binding .}"/>
                         
                        </ViewCell.ContextActions>
                        <Grid
                            ColumnDefinitions="*,*,*,*,*">
                            <Label 
                                Grid.Column="0"
                                Text="{Binding Id}"/>

                            <Label 
                                 Grid.Column="1"
                                 Text="{Binding Description}"/>

                            <Label 
                                 Grid.Column="2"
                                 Text="{Binding Amount}"/>

                            <Label 
                                 Grid.Column="3"
                                 Text="{Binding Price}"/>

                            <Label 
                              Grid.Column="4"
                              Text="{Binding Total}"/>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>