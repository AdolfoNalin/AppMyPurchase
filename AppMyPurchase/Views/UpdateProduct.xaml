<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMyPurchase.Views.UpdateProduct"
             Title="Atualiza">
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Atualizar"
            Clicked="ToolbarItem_Clicked_Update"/>
    </ContentPage.ToolbarItems>
    <VerticalStackLayout
        Spacing="10"
        Margin="10">
        <Label 
           Text="Descrição"/>
        <Entry 
            Text="{Binding Description}"
            x:Name="txtDescription"/>

        <Label 
            Text="Quantidate"/>
        <Entry 
            Text="{Binding Amount}"
            x:Name="txtAmount"/>

        <Label 
            Text="Preço"/>
        <Entry 
            Text="{Binding Price}"
            x:Name="txtPrice"/>
    </VerticalStackLayout>
</ContentPage>